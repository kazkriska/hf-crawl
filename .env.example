# Docker Compose Environment Variables for HF Crawl

# Your Hugging Face API token (optional, for higher rate limits)
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Environment: dev or prod
#   dev  → uses config.dev.yaml (smaller logs, dev DB path)
#   prod → uses config.prod.yaml (production DB, higher log threshold)
HF_CRAWL_ENV=dev

# Max items to fetch per phase (leave empty for unlimited)
# Useful for testing: HF_CRAWL_MAX_ITEMS=50
HF_CRAWL_MAX_ITEMS=

# Ports (change if you have conflicts)
HF_CRAWL_METRICS_PORT=8000
HF_CRAWL_WEB_PORT=8501
