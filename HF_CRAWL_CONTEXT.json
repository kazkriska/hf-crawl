    "resume_logic": [
      "On startup, check for existing checkpoint",
      "If exists -> resume from cursor/last_model_id",
      "If not -> start from beginning",
      "UPSERT ensures re-running doesn't create duplicates",
      "last_modified / ETag checks skip unchanged models"
    ]
