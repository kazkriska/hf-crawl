{
  "document_type": "handoff_context",
  "format_version": "1.0",
  "created_at": "2026-09-13",
  "project": {
    "name": "HF Crawl",
    "location": "Projects/hf-crawl/",
    "goal": "Fetch and store model cards for all ~1.8-2 million public models on Hugging Face Hub",
    "status": "planning_complete_ready_for_implementation",
    "phases": ["list", "info", "card"]
  },
  "decisions": [
    {
      "id": "d1",
      "topic": "sort_parameter",
      "decision": "createdAt ascending",
      "rationale": "Immutable field, stable page ordering, new models append to end",
      "alternatives_rejected": ["lastModified (mutable, causes mid-crawl shifts)"]
    },
    {
      "id": "d2",
      "topic": "pipeline_architecture",
      "decision": "3-phase: list -> info -> card",
      "rationale": "Separation of concerns, parallelizable, re-runnable"
    },
    {
      "id": "d3",
      "topic": "database_engine",
      "decision": "DuckDB",
      "rationale": "Single-file, columnar, compressed, fast analytics"
    },
    {
      "id": "d4",
      "topic": "table_design",
      "decision": "3 tables with FK chain",
      "rationale": "Normalized, no sparse columns, clean joins"
    },
    {
      "id": "d5",
      "topic": "phase_gating",
      "decision": "Phase 2 at 25%, Phase 3 at 100%",
      "rationale": "Early info crawl, cards only after full info"
    },
    {
      "id": "d6",
      "topic": "orchestrator",
      "decision": "Central coordinator",
      "rationale": "Single entry point, signal handling, metrics, health"
    },
    {
      "id": "d7",
      "topic": "concurrency",
      "decision": "Asyncio, semaphore-controlled",
      "rationale": "I/O bound, single IP, safe for HF rate limits"
    },
    {
      "id": "d8",
      "topic": "metrics",
      "decision": "Prometheus /metrics endpoint",
      "rationale": "Integrates with existing Grafana server"
    },
    {
      "id": "d9",
      "topic": "dev_prod_isolation",
      "decision": "Separate DB files",
      "rationale": "Clean slate for prod, test data never pollutes"
    },
    {
      "id": "d10",
      "topic": "testing_strategy",
      "decision": "Smoke (50 items) + Dev (500 items)",
      "rationale": "Full code path verification before prod"
    },
    {
      "id": "d11",
      "topic": "incremental_updates",
      "decision": "lastModified polling + ETag",
      "rationale": "Post-crawl freshness without full re-crawl"
    },
    {
      "id": "d12",
      "topic": "resumability",
      "decision": "Per-phase checkpoints",
      "rationale": "Re-runnable after crashes, no duplicate work"
    }
  ],
  "database_schema": {
    "models_list": {
      "description": "Phase 1 output",
      "columns": [
        {"name": "model_id", "type": "VARCHAR", "constraint": "PRIMARY KEY"},
        {"name": "author", "type": "VARCHAR"},
        {"name": "created_at", "type": "TIMESTAMP"},
        {"name": "last_modified", "type": "TIMESTAMP"},
        {"name": "downloads", "type": "BIGINT", "default": 0},
        {"name": "downloads_all_time", "type": "BIGINT", "default": 0},
        {"name": "likes", "type": "INTEGER", "default": 0},
        {"name": "trending_score", "type": "FLOAT"},
        {"name": "pipeline_tag", "type": "VARCHAR"},
        {"name": "library_name", "type": "VARCHAR"},
        {"name": "tags", "type": "JSON"},
        {"name": "etag", "type": "VARCHAR"},
        {"name": "fetched_at", "type": "TIMESTAMP"},
        {"name": "list_page", "type": "INTEGER"},
        {"name": "list_cursor", "type": "VARCHAR"},
        {"name": "fetch_status", "type": "VARCHAR", "default": "success"}
      ]
    },
    "model_info": {
      "description": "Phase 2 output",
      "columns": [
        {"name": "model_id", "type": "VARCHAR", "constraint": "PRIMARY KEY"},
        {"name": "sha", "type": "VARCHAR"},
        {"name": "card_data", "type": "JSON"},
        {"name": "base_models", "type": "JSON"},
        {"name": "datasets", "type": "JSON"},
        {"name": "config", "type": "JSON"},
        {"name": "eval_results", "type": "JSON"},
        {"name": "gguf", "type": "JSON"},
        {"name": "safetensors", "type": "JSON"},
        {"name": "transformers_info", "type": "JSON"},
        {"name": "siblings", "type": "JSON"},
        {"name": "used_storage", "type": "BIGINT"},
        {"name": "gated", "type": "VARCHAR"},
        {"name": "disabled", "type": "BOOLEAN", "default": false},
        {"name": "etag", "type": "VARCHAR"},
        {"name": "fetched_at", "type": "TIMESTAMP"},
        {"name": "fetch_status", "type": "VARCHAR", "default": "success"},
        {"name": "fetch_error", "type": "TEXT"}
      ],
      "foreign_key": "model_id -> models_list.model_id"
    },
    "model_card": {
      "description": "Phase 3 output",
      "columns": [
        {"name": "model_id", "type": "VARCHAR", "constraint": "PRIMARY KEY"},
        {"name": "readme_raw", "type": "TEXT"},
        {"name": "readme_size", "type": "INTEGER"},
        {"name": "yaml_metadata", "type": "JSON"},
        {"name": "content_hash", "type": "VARCHAR"},
        {"name": "etag", "type": "VARCHAR"},
        {"name": "fetched_at", "type": "TIMESTAMP"},
        {"name": "fetch_status", "type": "VARCHAR", "default": "success"},
        {"name": "fetch_error", "type": "TEXT"}
      ],
      "foreign_key": "model_id -> models_list.model_id"
    }
  },
  "prometheus_metrics": {
    "counters": [
      {"name": "hf_crawl_models_fetched_total", "labels": ["phase", "status"]},
      {"name": "hf_crawl_requests_total", "labels": ["endpoint", "status_code"]},
      {"name": "hf_crawl_rate_limit_hits_total", "labels": ["endpoint"]}
    ],
    "gauges": [
      {"name": "hf_crawl_phase_progress_pct", "labels": ["phase"]},
      {"name": "hf_crawl_phase_status", "labels": ["phase"]},
      {"name": "hf_crawl_rate_limit_remaining", "labels": ["bucket"]},
      {"name": "hf_crawl_db_size_bytes", "labels": []},
      {"name": "hf_crawl_disk_free_bytes", "labels": []},
      {"name": "hf_crawl_active_workers", "labels": ["phase"]},
      {"name": "hf_crawl_throughput_models_per_second", "labels": ["phase"]}
    ],
    "histograms": [
      {"name": "hf_crawl_request_duration_seconds", "labels": ["endpoint", "status_code"]},
      {"name": "hf_crawl_batch_commit_duration_seconds", "labels": ["phase"]}
    ]
  },
  "grafana_dashboard": {
    "panels": [
      "Phase Progress (Gauge x3)",
      "Phase Status (Stat)",
      "Throughput (Time Series)",
      "Total Fetched (Counter)",
      "Request Rate (Time Series by status_code)",
      "Rate Limit Remaining (Gauge)",
      "Request Latency (Heatmap)",
      "DB Size (Time Series)",
      "Disk Space (Gauge)",
      "Active Workers (Time Series)",
      "Error Rate (Time Series)"
    ],
    "alerts": [
      {"name": "HighRateLimitHits", "condition": "rate(rate_limit_hits_total[5m]) > 5", "severity": "warning"},
      {"name": "LowDiskSpace", "condition": "disk_free_bytes < 10GB", "severity": "critical"},
      {"name": "PhaseStuck", "condition": "delta(phase_progress_pct[30m]) == 0", "severity": "warning"}
    ]
  },
  "huggingface_api": {
    "endpoints": {
      "list_models": "GET /api/models",
      "model_info": "GET /api/models/{model_id}",
      "model_card": "GET /{model_id}/raw/main/README.md"
    },
    "list_models_parameters": {
      "sort": "createdAt (for initial crawl)",
      "direction": "1 (ascending)",
      "limit": "1000 (page size)",
      "cursor": "server-generated, base64-encoded"
    },
    "rate_limits_per_5min": {
      "anonymous": {"api": 500, "resolvers": 3000, "pages": 100},
      "free": {"api": 1000, "resolvers": 5000, "pages": 200},
      "pro": {"api": 2500, "resolvers": 12000, "pages": 400},
      "enterprise": {"api": 6000, "resolvers": 50000, "pages": 600}
    },
    "safe_rates": {
      "phase1_api": "2-3 req/sec",
      "phase2_api": "2-3 req/sec",
      "phase3_resolvers": "10-20 req/sec",
      "max_concurrent": 5
    },
    "retry_strategy": {
      "429": "Parse RateLimit header, wait exact seconds, retry",
      "5xx": "Exponential backoff (1,2,4,8, max 60s) + jitter",
      "404": "Mark deleted, skip",
      "403": "Mark gated/private, skip",
      "timeout": "Retry up to 3 times, then mark failed",
      "connection_reset": "Retry with backoff",
      "max_retries": 5
    }
  },
